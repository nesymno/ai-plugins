{
  "$comment": "Session-wide policy. permissions.deny is enforced by Claude Code itself and is the backstop for the hook denylists.",

  "permissions": {
    "deny": [
      "Bash(kubectl apply:*)",
      "Bash(kubectl delete:*)",
      "Bash(kubectl patch:*)",
      "Bash(kubectl scale:*)",
      "Bash(kubectl drain:*)",
      "Bash(kubectl rollout:*)",
      "Bash(helm install:*)",
      "Bash(helm upgrade:*)",
      "Bash(helm uninstall:*)",
      "Bash(terraform apply:*)",
      "Bash(terraform destroy:*)",
      "Bash(tofu apply:*)",
      "Bash(tofu destroy:*)",
      "Bash(docker push:*)",
      "Bash(gh workflow run:*)",
      "Bash(git push --force:*)"
    ]
  },

  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/session-start.sh" }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          { "type": "command", "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/telemetry.sh" }
        ]
      }
    ]
  },

  "skillOverrides": {
    "$comment": "Set to name-only or off for skills that should live inside agents rather than fire in the main session. Has no effect on plugin skills - install the samber sets as plain skills, not as a plugin.",
    "golang-stay-updated": "off",
    "golang-popular-libraries": "name-only",
    "golang-cli": "off",
    "golang-benchmark": "name-only",
    "golang-security": "name-only",
    "golang-performance": "name-only"
  },

  "env": {
    "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "2"
  }
}
